APP_NAME=Recruitment System API
# development | staging | production — staging/production refuse to boot with
# unsafe settings (wildcard/http CORS, empty DB password, AI enabled).
APP_ENV=development
APP_PORT=8000
API_PREFIX=/api/v1

# Exact browser origins allowed to call the API (comma-separated, no "*").
# The UI normally calls the API same-origin through frontend/server.js.
CORS_ORIGINS=http://localhost:4174,http://127.0.0.1:4174,http://localhost:3000,http://127.0.0.1:3000
FRONTEND_BASE_URL=http://localhost:4174
SESSION_TTL_HOURS=12

DB_HOST=localhost
DB_PORT=1433
DB_NAME=recruitment_system
DB_USER=sa
DB_PASSWORD=your_password_here
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_BYTES=10485760
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.doc,.docx,.jpg,.jpeg,.png

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password
# Port 465 = implicit TLS; any other port (587) upgrades with STARTTLS when SMTP_USE_TLS=true.
# Staging/production refuse to boot unless EMAIL_ENABLED=true, SMTP_HOST and EMAIL_FROM_ADDRESS are set,
# SMTP_USE_TLS=true and FRONTEND_BASE_URL is https:// (it is the link in every email).
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=15
EMAIL_FROM_NAME=RecruitOps
EMAIL_FROM_ADDRESS=noreply@example.com
EMAIL_REPLY_TO=
EMAIL_ENABLED=false

# AI agents: on in development, forced off in staging/production (decision D-10).
AI_ENABLED=false
AI_PROVIDER=mock
AI_MAX_ITEMS_PER_RUN=20

# ── Not yet consumed: scaffolding for later readiness phases ──
# Object storage (Phase 4): local | s3
STORAGE_BACKEND=local
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
SIGNED_URL_TTL_SECONDS=300
# Rate limits / session denylist (Phase 3)
REDIS_URL=
# How many reverse proxies (your load balancer, etc.) sit in front of this
# app and may be trusted to set X-Forwarded-For/X-Forwarded-Proto. 0 in
# development; staging/production must set this to the real hop count
# (usually 1) or boot fails -- see app/core/net.py.
TRUSTED_PROXY_COUNT=0
# JWT access + rotating refresh (Phase 3) — load from a secrets manager in prod
JWT_SIGNING_KEY=
JWT_ACCESS_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
