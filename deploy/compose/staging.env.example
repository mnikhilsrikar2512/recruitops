# Production-like local stack (APP_ENV=staging: every production guard is on).
# Copy to staging.env and fill the blanks:
#   cp deploy/compose/staging.env.example deploy/compose/staging.env
# Fill the secrets:  python3 deploy/compose/gen_secrets.py deploy/compose/staging.env
# Never reuse these values in a real environment.

APP_ENV=staging
APP_NAME=RecruitOps API
FRONTEND_BASE_URL=https://localhost:8443
CORS_ORIGINS=https://localhost:8443
# Caddy (TLS) -> nginx (web) -> API: two of our own proxies append to X-Forwarded-For.
TRUSTED_PROXY_COUNT=2
WEB_CONCURRENCY=2

DB_HOST=sqlserver
DB_PORT=1433
DB_NAME=recruitops
DB_USER=sa
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true

REDIS_URL=redis://redis:6379/0

STORAGE_BACKEND=s3
S3_BUCKET=recruitops-files
S3_REGION=us-east-1
S3_ENDPOINT_URL=http://s3.localhost:8333
S3_ACCESS_KEY_ID=recruitops
MALWARE_SCANNER=clamav
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

EMAIL_ENABLED=true
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USE_TLS=true
SMTP_VALIDATE_CERTS=false
EMAIL_FROM_NAME=RecruitOps (local)
EMAIL_FROM_ADDRESS=no-reply@recruitops.local

LOG_LEVEL=INFO
LOG_FORMAT=json

# ---- secrets (gen_secrets.py fills these) ----
DB_PASSWORD=
MSSQL_SA_PASSWORD=
S3_SECRET_ACCESS_KEY=
JWT_SIGNING_KEY=
MFA_ENCRYPTION_KEYS=
METRICS_TOKEN=
