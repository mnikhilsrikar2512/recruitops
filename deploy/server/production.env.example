# /opt/recruitops/production.env on the server. Never commit the real file.
# Values can instead be files in SECRETS_DIR (one file per setting).
# Staging uses the same file with its own values (APP_ENV=staging).

APP_ENV=production
APP_NAME=RecruitOps API
DOMAIN=app.example.com
ACME_EMAIL=ops@example.com
FRONTEND_BASE_URL=https://app.example.com
CORS_ORIGINS=https://app.example.com
# Caddy (TLS) -> nginx (web) -> API
TRUSTED_PROXY_COUNT=2
WEB_CONCURRENCY=4

# Managed SQL Server / Azure SQL. The app login needs no DDL rights;
# migrations use MIGRATE_DB_* (see docs/runbooks/deploy.md).
DB_HOST=
DB_PORT=1433
DB_NAME=recruitops
DB_USER=recruitops_app
DB_PASSWORD=
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=false
MIGRATE_DB_USER=recruitops_migrator
MIGRATE_DB_PASSWORD=

REDIS_URL=rediss://:password@host:6380/0

STORAGE_BACKEND=s3
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MALWARE_SCANNER=clamav
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

EMAIL_ENABLED=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM_NAME=RecruitOps
EMAIL_FROM_ADDRESS=no-reply@example.com
EMAIL_REPLY_TO=support@example.com

JWT_SIGNING_KEY=
MFA_ENCRYPTION_KEYS=
METRICS_TOKEN=

LOG_LEVEL=INFO
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
# Healthchecks.io-style base URL; each scheduled job pings <url>/<job>[/fail].
JOB_HEARTBEAT_URL=

# Backups (scripts/backup_db.py, nightly; restore drill monthly). Prefer a
# separate bucket in another account with object lock; docs/runbooks/backup-restore.md
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=backups/
BACKUP_RETENTION_DAYS=35
BACKUP_MONTHLY_KEEP=12
# The drill restores into a scratch database here (needs CREATE DATABASE).
DRILL_DB_HOST=
# How long audit rows are kept (>= 365). Unset = forever. Owner decision.
AUDIT_RETENTION_DAYS=
